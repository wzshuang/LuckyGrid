{
  "name": "@luckygrid/compat",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@luckygrid/core": "workspace:*",
    "@luckygrid/vue": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
