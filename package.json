{
  "name": "LuckyGrid",
  "private": true,
  "version": "0.1.0",
  "description": "Luckysheet Vue 3 rewrite — Path A MVP",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @luckygrid/playground dev",
    "dev:site": "pnpm --filter @luckygrid/gh-pages-demo dev",
    "build": "pnpm -r --filter=./packages/* build",
    "build:site": "pnpm --filter @luckygrid/gh-pages-demo build",
    "test": "pnpm --filter @luckygrid/core test",
    "typecheck": "pnpm -r --filter=./packages/* typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
